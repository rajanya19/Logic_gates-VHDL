Library ieee;
use ieee.std_logic_1164.all;
entity OR_gate_behav is
port(A:in std_logic;
B:in std_logic;
Y:out std_logic);
end Or_gate_behav;
architecture behav of Or_gate_behav is
begin 
process(A,B)
begin
if(A='0' and B='0') then 
Y<='0';
elsif(A='0' and B='1') then
Y<='1';
elsif(A='1' and B='0') then
Y<='1';
elsif(A='1' and B='1') then 
Y<='1';
end if;
end process;
end behav;