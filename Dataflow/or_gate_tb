library ieee;
use ieee.std_logic_1164.all;

entity or_gate_tb is
end or_gate_tb;

architecture test of or_gate_tb is

component or_gate
port(
A : in std_logic;
B : in std_logic;
Y : out std_logic
);
end component;

signal A,B,Y : std_logic;

begin

UUT: or_gate port map(A,B,Y);

process
begin

A<='0'; B<='0';
wait for 10 ns;

A<='0'; B<='1';
wait for 10 ns;

A<='1'; B<='0';
wait for 10 ns;

A<='1'; B<='1';
wait for 10 ns;

wait;

end process;

end test;